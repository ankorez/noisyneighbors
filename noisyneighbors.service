[Unit]
Description=NoisyNeighbors - Noise detection and replay
After=sound.target bluetooth.target

[Service]
Type=simple
User=__USER__
Environment=XDG_RUNTIME_DIR=/run/user/__UID__
WorkingDirectory=__HOME__/noisyneighbors
ExecStart=__HOME__/noisyneighbors/venv/bin/python3 __HOME__/noisyneighbors/noisyneighbors.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
